digraph G {
  graph [rankdir=LR, bgcolor="#ffffff", pad=0.35, nodesep=0.55, ranksep=0.75, splines=ortho]
  node [shape=box, style="rounded,filled", fontname="Architects Daughter", fontsize=12, margin="0.14,0.09", color="#94a3b8", fillcolor="#f8fafc"]
  edge [fontname="Comic Mono", fontsize=10, penwidth=1.8, arrowsize=0.75, color="#3B82F6"]
  route [label="Ktor route\nidentity + target", fillcolor="#E8F3FF", color="#5B8DEF"]
  plugin [label="Access Grants plugin\nconfigure runtime", fillcolor="#EAF7EF", color="#58A978"]
  control [label="S3 Control lookup\ngrant/session", fillcolor="#E9F7F6", color="#45A7A1"]
  client [label="S3 client\nscoped object call", fillcolor="#FFF7ED", color="#F97316"]
  response [label="HTTP response\nmapped result", fillcolor="#F1ECFF", color="#8A72D6"]
  route -> plugin
  plugin -> control
  control -> client
  client -> response
}
