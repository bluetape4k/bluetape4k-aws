digraph examples_aws_ktor_sqs_examples_architecture_01 {
  graph [rankdir=TB, bgcolor="#ffffff", pad=0.35, nodesep=0.48, ranksep=0.70, splines=ortho]
  node [shape=box, style="rounded,filled", fontname="Architects Daughter", fontsize=12, margin="0.14,0.09", color="#94a3b8", fillcolor="#f8fafc"]
  edge [fontname="Comic Mono", fontsize=10, color="#64748b", penwidth=1.5, arrowsize=0.75]
  client [label="HTTP client / test\nqueue route calls", fillcolor="#E8F3FF", color="#5B8DEF"]
  routes [label="Ktor queue routes\nsend, create, delete\nattributes, inspect state", fillcolor="#EAF7EF", color="#58A978"]
  plugin [label="SqsConsumer plugin\npolling coroutines", fillcolor="#FFF3D9", color="#D6A441"]
  hooks [label="Advanced hooks\nmanual ack/nack\ninterceptors, observers", fillcolor="#F1ECFF", color="#8A72D6"]
  store [label="Inspection state\nreceived bodies\nevents and observations", fillcolor="#FDECEF", color="#DC6B82"]
  sqs [label="Floci-backed SQS\nthrough SqsAsyncClient", fillcolor="#FFF0E3", color="#F47B36", shape=cylinder]
  client -> routes
  routes -> sqs [label="publish"]
  sqs -> plugin [label="messages"]
  plugin -> hooks
  hooks -> store
  routes -> store [label="inspect"]
}
