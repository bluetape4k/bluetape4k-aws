digraph KtorSqsExamplesArchitecture {
  graph [rankdir=LR, bgcolor="#ffffff", pad=0.35, nodesep=0.45, ranksep=0.70, splines=ortho]
  node [shape=box, style="rounded,filled", fontname="Helvetica", fontsize=12, margin="0.14,0.09", color="#94a3b8", fillcolor="#f8fafc"]
  edge [fontname="Helvetica", fontsize=10, color="#64748b", penwidth=1.5, arrowsize=0.75]

  client [label="HTTP client or test", fillcolor="#e0f2fe", color="#38bdf8"]
  routes [label="Ktor queue routes\nsend, create, delete,\nattributes, inspect state", fillcolor="#dcfce7", color="#22c55e"]
  plugin [label="SqsConsumer plugin\npolling coroutines", fillcolor="#fef3c7", color="#f59e0b"]
  hooks [label="Advanced hooks\nmanual ack/nack,\ninterceptors, observers", fillcolor="#f3e8ff", color="#a855f7"]
  store [label="In-memory inspection\nreceived bodies, lifecycle events,\nobservation summaries", fillcolor="#fee2e2", color="#ef4444"]
  sqs [label="Floci-backed SQS\nthrough SqsAsyncClient", shape=cylinder, fillcolor="#fff7ed", color="#f97316"]

  client -> routes
  routes -> sqs [label="publish and manage"]
  plugin -> sqs [label="long poll"]
  sqs -> plugin [label="messages"]
  plugin -> hooks
  hooks -> store
  routes -> store [label="read inspection"]
}
