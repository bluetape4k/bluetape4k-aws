  spring_auto [label="Spring Boot 4\nauto-config\ntemplates/listeners", fillcolor="#EAF7EF", color="#58A978"]
  ktor_plugins [label="Ktor 3 plugins\nSigV4\nS3/SQS/DynamoDB", fillcolor="#F1ECFF", color="#8A72D6"]
