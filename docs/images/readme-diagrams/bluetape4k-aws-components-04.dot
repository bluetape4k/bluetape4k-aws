  kotlin_wrappers [label="Kotlin SDK helpers\nnative suspend\nDSL builders", fillcolor="#FFF3D9", color="#D6A441"]
  database_config [label="Exposed + RDS IAM\nHikari Database\nregistry handles", fillcolor="#FDECEF", color="#DC6B82"]
  remote_config [label="Secrets / Parameter\nsource descriptors\nexternalized config", fillcolor="#F8FAFC", color="#64748B"]
