digraph aws_java_sequence_03 {
  graph [rankdir=TB, bgcolor="#ffffff", pad=0.35, nodesep=0.48, ranksep=0.70, splines=ortho]
  node [shape=box, style="rounded,filled", fontname="Architects Daughter", fontsize=12, margin="0.14,0.09", color="#94a3b8", fillcolor="#f8fafc"]
  edge [fontname="Comic Mono", fontsize=10, color="#64748b", penwidth=1.5, arrowsize=0.75]
  caller [label="Suspend caller\nrepository or service", fillcolor="#E8F3FF", color="#5B8DEF"]
  adapter [label="Coroutine extension\nbuild request and call async client", fillcolor="#F1ECFF", color="#8A72D6"]
  sdk [label="AWS async client\nreturns CompletableFuture", fillcolor="#F4F7FA", color="#8CA0B3"]
  future [label="Future completes\nsuccess or exception", fillcolor="#EAF7EF", color="#58A978"]
  resume [label="Coroutine resumes\nresponse, Flow item, or failure", fillcolor="#E9F7F6", color="#45A7A1"]
  close [label="Caller owns client lifecycle\nclose application-scoped clients", fillcolor="#FFF0E3", color="#F47B36"]
  caller -> adapter [label="suspend call"]
  adapter -> sdk [label="async request"]
  sdk -> future
  future -> resume [label="await"]
  resume -> close
}
