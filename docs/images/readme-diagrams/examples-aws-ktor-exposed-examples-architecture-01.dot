digraph KtorExposedExamplesArchitecture {
  graph [rankdir=LR, bgcolor="#ffffff", pad=0.35, nodesep=0.45, ranksep=0.70, splines=ortho]
  node [shape=box, style="rounded,filled", fontname="Architects Daughter", fontsize=12, margin="0.14,0.09", color="#94a3b8", fillcolor="#f8fafc"]
  edge [fontname="Comic Mono", fontsize=10, color="#64748b", penwidth=1.5, arrowsize=0.75]

  client [label="HTTP client or test", fillcolor="#e0f2fe", color="#38bdf8"]
  routes [label="Ktor order routes\ncreate, read, list, 404", fillcolor="#dcfce7", color="#22c55e"]
  tx [label="call.awsExposedTransaction\nblocking JDBC on Dispatchers.IO", fillcolor="#fef3c7", color="#f59e0b"]
  repo [label="OrderRepository\nExposed queries only", fillcolor="#f3e8ff", color="#a855f7"]
  plugin [label="AwsExposedPlugin\nregistry and lifecycle", fillcolor="#fee2e2", color="#ef4444"]
  pg [label="PostgreSQL Testcontainer\nor production JDBC database", shape=cylinder, fillcolor="#fff7ed", color="#f97316"]

  client -> routes
  routes -> tx
  tx -> repo
  plugin -> tx [label="provides database"]
  repo -> pg
  plugin -> pg [label="Hikari pool"]
}
