digraph examples_aws_ktor_exposed_examples_architecture_01 {
  graph [rankdir=TB, bgcolor="#ffffff", pad=0.35, nodesep=0.48, ranksep=0.70, splines=ortho]
  node [shape=box, style="rounded,filled", fontname="Architects Daughter", fontsize=12, margin="0.14,0.09", color="#94a3b8", fillcolor="#f8fafc"]
  edge [fontname="Comic Mono", fontsize=10, color="#64748b", penwidth=1.5, arrowsize=0.75]
  client [label="HTTP client / test\ncreate, read, list", fillcolor="#E8F3FF", color="#5B8DEF"]
  routes [label="Ktor order routes\nroute handlers\n404 behavior", fillcolor="#EAF7EF", color="#58A978"]
  tx [label="awsExposedTransaction\nblocking JDBC\nDispatchers.IO", fillcolor="#FFF3D9", color="#D6A441"]
  repo [label="OrderRepository\nExposed queries only", fillcolor="#F1ECFF", color="#8A72D6"]
  plugin [label="AwsExposedPlugin\nregistry\ndatabase lifecycle", fillcolor="#FDECEF", color="#DC6B82"]
  pg [label="PostgreSQL database\nTestcontainers or production", fillcolor="#FFF0E3", color="#F47B36", shape=cylinder]
  client -> routes
  routes -> tx
  plugin -> tx [label="database"]
  tx -> repo
  repo -> pg
  plugin -> pg [label="pool"]
}
