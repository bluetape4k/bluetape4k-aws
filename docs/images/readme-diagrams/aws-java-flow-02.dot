digraph G {
  graph [rankdir=LR, bgcolor="#ffffff", pad=0.35, nodesep=0.55, ranksep=0.75, splines=ortho]
  node [shape=box, style="rounded,filled", fontname="Architects Daughter", fontsize=12, margin="0.14,0.09", color="#94a3b8", fillcolor="#f8fafc"]
  edge [fontname="Comic Mono", fontsize=10, penwidth=1.8, arrowsize=0.75, color="#3B82F6"]
  call [label="Suspend extension\nservice helper\nKotlin caller", fillcolor="#E8F3FF", color="#5B8DEF"]
  request [label="Request DSL\ntyped builder\noverride config", fillcolor="#EAF7EF", color="#58A978"]
  async [label="Async SDK call\nCompletableFuture\nnon-blocking", fillcolor="#E9F7F6", color="#45A7A1"]
  await [label="await()\nresume coroutine\nmap result", fillcolor="#FFF3D9", color="#D6A441"]
  result [label="Typed result\nmodel/Flow\ncaller-owned", fillcolor="#F1ECFF", color="#8A72D6"]
  call -> request
  request -> async
  async -> await
  await -> result
}
