digraph aws_java_flow_02 {
  graph [rankdir=TB, bgcolor="#ffffff", pad=0.35, nodesep=0.48, ranksep=0.70, splines=ortho]
  node [shape=box, style="rounded,filled", fontname="Architects Daughter", fontsize=12, margin="0.14,0.09", color="#94a3b8", fillcolor="#f8fafc"]
  edge [fontname="Comic Mono", fontsize=10, color="#64748b", penwidth=1.5, arrowsize=0.75]
  caller [label="Caller\nsync, async, or suspend API", fillcolor="#E8F3FF", color="#5B8DEF"]
  builder [label="Request builder DSL\ntyped AWS model construction", fillcolor="#FFF3D9", color="#D6A441"]
  client [label="AWS SDK v2 client\nservice operation call", fillcolor="#F4F7FA", color="#8CA0B3"]
  future [label="CompletableFuture result\nasync response boundary", fillcolor="#EAF7EF", color="#58A978"]
  suspend [label="Coroutine wrapper\nawait(), Flow, suspend API", fillcolor="#E9F7F6", color="#45A7A1"]
  caller -> builder
  builder -> client
  client -> future
  future -> suspend
}
