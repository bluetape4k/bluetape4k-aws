digraph examples_aws_spring_boot_s3_examples_architecture_01 {
  graph [rankdir=TB, bgcolor="#ffffff", pad=0.35, nodesep=0.48, ranksep=0.70, splines=ortho]
  node [shape=box, style="rounded,filled", fontname="Architects Daughter", fontsize=12, margin="0.14,0.09", color="#94a3b8", fillcolor="#f8fafc"]
  edge [fontname="Comic Mono", fontsize=10, color="#64748b", penwidth=1.5, arrowsize=0.75]
  client [label="HTTP client / test\ndocument route calls", fillcolor="#E8F3FF", color="#5B8DEF"]
  controller [label="S3DocumentController\nupload, download, list\npresigned URL, delete", fillcolor="#EAF7EF", color="#58A978"]
  ops [label="S3Operations\nS3CoroutinesTemplate\ntransfer and presign", fillcolor="#FFF3D9", color="#D6A441"]
  encrypt [label="Encryption routes\nclient-side envelope\ntenant context", fillcolor="#F1ECFF", color="#8A72D6"]
  kms [label="KmsOperations\ndata key metadata", fillcolor="#FDECEF", color="#DC6B82"]
  s3 [label="S3 endpoint\nLocalStack or AWS", fillcolor="#FFF0E3", color="#F47B36", shape=cylinder]
  client -> controller
  controller -> ops
  controller -> encrypt
  encrypt -> kms
  ops -> s3
  encrypt -> s3
}
