digraph G {
  graph [rankdir=LR, bgcolor="#ffffff", pad=0.35, nodesep=0.55, ranksep=0.75, splines=ortho]
  node [shape=box, style="rounded,filled", fontname="Architects Daughter", fontsize=12, margin="0.14,0.09", color="#94a3b8", fillcolor="#f8fafc"]
  edge [fontname="Comic Mono", fontsize=10, penwidth=1.8, arrowsize=0.75, color="#3B82F6"]
  sync [label="Sync SDK clients\nblocking AWS SDK v2\nfactories/support", fillcolor="#E8F3FF", color="#5B8DEF"]
  async [label="Async SDK clients\nCompletableFuture\nNetty/CRT HTTP", fillcolor="#EAF7EF", color="#58A978"]
  suspend [label="Coroutine extensions\nawait wrappers\nFlow adapters", fillcolor="#E9F7F6", color="#45A7A1"]
  services [label="Service packages\nDynamoDB, S3, SQS\nKMS, CloudWatch, STS", fillcolor="#FFF7ED", color="#F97316"]
  sync -> async
  async -> suspend
  suspend -> services
}
