digraph KtorS3ExamplesArchitecture {
  graph [rankdir=LR, bgcolor="#ffffff", pad=0.35, nodesep=0.45, ranksep=0.70, splines=ortho]
  node [shape=box, style="rounded,filled", fontname="Architects Daughter", fontsize=12, margin="0.14,0.09", color="#94a3b8", fillcolor="#f8fafc"]
  edge [fontname="Comic Mono", fontsize=10, color="#64748b", penwidth=1.5, arrowsize=0.75]

  client [label="HTTP client or test", fillcolor="#e0f2fe", color="#38bdf8"]
  routes [label="Ktor S3 routes\nupload, download, stream,\nlist, delete, presign", fillcolor="#dcfce7", color="#22c55e"]
  advanced [label="Advanced routes\ncontent-type detection,\nconfig data, encryption demo", fillcolor="#fef3c7", color="#f59e0b"]
  examples [label="S3KtorExamples\nlocal client and scenario helpers", fillcolor="#f3e8ff", color="#a855f7"]
  s3client [label="S3KtorClient\nSigV4 REST calls", fillcolor="#fee2e2", color="#ef4444"]
  s3 [label="S3-compatible endpoint\nAWS S3, LocalStack, or Floci", shape=cylinder, fillcolor="#fff7ed", color="#f97316"]

  client -> routes
  client -> advanced
  routes -> s3client
  advanced -> examples
  examples -> s3client
  s3client -> s3
}
