digraph examples_aws_ktor_s3_examples_architecture_01 {
  graph [rankdir=TB, bgcolor="#ffffff", pad=0.35, nodesep=0.48, ranksep=0.70, splines=ortho]
  node [shape=box, style="rounded,filled", fontname="Architects Daughter", fontsize=12, margin="0.14,0.09", color="#94a3b8", fillcolor="#f8fafc"]
  edge [fontname="Comic Mono", fontsize=10, color="#64748b", penwidth=1.5, arrowsize=0.75]
  client [label="HTTP client / test\nobject and config routes", fillcolor="#E8F3FF", color="#5B8DEF"]
  routes [label="Ktor S3 routes\nupload, download, stream\nlist, delete, presign", fillcolor="#EAF7EF", color="#58A978"]
  advanced [label="Advanced routes\ncontent-type detection\nconfig data, encryption demo", fillcolor="#FFF3D9", color="#D6A441"]
  helpers [label="S3KtorExamples\nlocal client\nscenario helpers", fillcolor="#F1ECFF", color="#8A72D6"]
  s3client [label="S3KtorClient\nSigV4 REST calls", fillcolor="#FDECEF", color="#DC6B82"]
  s3 [label="S3-compatible endpoint\nAWS S3, LocalStack, Floci", fillcolor="#FFF0E3", color="#F47B36", shape=cylinder]
  client -> routes
  client -> advanced
  routes -> helpers
  advanced -> helpers
  helpers -> s3client
  s3client -> s3
}
