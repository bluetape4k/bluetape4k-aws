digraph AwsKtorS3AdvancedSequence {
  graph [rankdir=LR, bgcolor="#ffffff", nodesep=0.45, ranksep=0.7]
  node [shape=box, style="rounded,filled", fontname="Helvetica", fontsize=12, margin="0.12,0.08"]
  edge [color="#64748b", penwidth=1.7, arrowsize=0.8]

  app [label="Ktor App", fillcolor="#e8f3ff", color="#5b8def"]
  helper [label="S3KtorClient\nadvanced helper", fillcolor="#fff3d9", color="#d6a441"]
  cse [label="Envelope Encryptor", fillcolor="#eef2ff", color="#8b7cf6"]
  datakey [label="Data Key Provider", fillcolor="#f3e8ff", color="#a36ad6"]
  sigv4 [label="AwsSigV4Plugin", fillcolor="#e8f7f6", color="#4ca6a8"]
  s3 [label="S3 bucket", shape=cylinder, fillcolor="#fff7ed", color="#f59e0b"]

  app -> helper [label="putConfigObject / putEncryptedObject"]
  helper -> cse [label="encrypt payload (optional)"]
  cse -> datakey [label="generate data key"]
  datakey -> cse [label="plaintext + encrypted key"]
  cse -> helper [label="ciphertext + metadata"]
  helper -> sigv4 [label="sign REST request"]
  sigv4 -> s3 [label="PutObject"]
  app -> helper [label="getConfigObject / getEncryptedObject"]
  helper -> sigv4 [label="sign GetObject"]
  sigv4 -> s3 [label="GetObject"]
  helper -> cse [label="decrypt when encrypted"]
  cse -> datakey [label="decrypt data key"]
  helper -> app [label="text config or plaintext"]
}
