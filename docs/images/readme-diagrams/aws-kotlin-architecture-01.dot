digraph AwsKotlinArchitecture {
  graph [rankdir=TB, bgcolor="#ffffff", pad=0.35, nodesep=0.48, ranksep=0.70, splines=ortho]
  node [shape=box, style="rounded,filled", fontname="Architects Daughter", fontsize=12, margin="0.14,0.09", color="#94a3b8", fillcolor="#f8fafc"]
  edge [fontname="Comic Mono", fontsize=10, color="#64748b", penwidth=1.5, arrowsize=0.75]

  app [label="Coroutine application\nnative suspend call sites", fillcolor="#e0f2fe", color="#38bdf8"]
  scoped [label="withXxxClient blocks\nauto-close client lifecycle", fillcolor="#dcfce7", color="#22c55e"]
  direct [label="xxxClientOf factories\nlong-lived client creation", fillcolor="#fef3c7", color="#f59e0b"]
  dsl [label="Kotlin DSL builders\nrequests, attributes, records, metrics", fillcolor="#f3e8ff", color="#a855f7"]
  flows [label="Flow helpers\nKinesis recordFlow and paged reads", fillcolor="#ecfeff", color="#06b6d4"]
  clients [label="AWS SDK for Kotlin clients\nDynamoDB, S3, SQS, SNS,\nKMS, CloudWatch, Kinesis, STS", fillcolor="#f8fafc", color="#94a3b8"]
  engines [label="HTTP engines\nCRT, default engine, OkHttp", fillcolor="#fee2e2", color="#fb7185"]
  aws [label="AWS services\nor local emulator", shape=cylinder, fillcolor="#fff7ed", color="#f97316"]

  app -> scoped
  app -> direct
  app -> dsl
  app -> flows
  scoped -> clients
  direct -> clients
  dsl -> clients
  flows -> clients
  engines -> clients
  clients -> aws
}
