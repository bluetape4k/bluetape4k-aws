digraph aws_kotlin_architecture_01 {
  graph [rankdir=TB, bgcolor="#ffffff", pad=0.35, nodesep=0.48, ranksep=0.70, splines=ortho]
  node [shape=box, style="rounded,filled", fontname="Architects Daughter", fontsize=12, margin="0.14,0.09", color="#94a3b8", fillcolor="#f8fafc"]
  edge [fontname="Comic Mono", fontsize=10, color="#64748b", penwidth=1.5, arrowsize=0.75]
  app [label="Coroutine application\nservice code with suspend calls", fillcolor="#E8F3FF", color="#5B8DEF"]
  builders [label="DSL builders\nrequests, models\nwait helpers", fillcolor="#FFF3D9", color="#D6A441"]
  with [label="withXClient helpers\ncreate, use, close", fillcolor="#EAF7EF", color="#58A978"]
  flows [label="Flow helpers\nKinesis recordFlow\npaged reads", fillcolor="#E9F7F6", color="#45A7A1"]
  clients [label="AWS SDK for Kotlin clients\nDynamoDB, S3, SQS, SNS\nKMS, CloudWatch, Kinesis, STS", fillcolor="#F4F7FA", color="#8CA0B3"]
  aws [label="AWS services\nor LocalStack / Floci", fillcolor="#FFF0E3", color="#F47B36", shape=cylinder]
  app -> builders
  app -> with
  app -> flows
  builders -> clients
  with -> clients
  flows -> clients
  clients -> aws
}
