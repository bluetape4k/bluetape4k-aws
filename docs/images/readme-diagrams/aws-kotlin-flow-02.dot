digraph G {
  graph [rankdir=LR, bgcolor="#ffffff", pad=0.35, nodesep=0.55, ranksep=0.75, splines=ortho]
  node [shape=box, style="rounded,filled", fontname="Architects Daughter", fontsize=12, margin="0.14,0.09", color="#94a3b8", fillcolor="#f8fafc"]
  edge [fontname="Comic Mono", fontsize=10, penwidth=1.8, arrowsize=0.75, color="#3B82F6"]
  scope [label="Coroutine scope\ncaller owns job", fillcolor="#E8F3FF", color="#5B8DEF"]
  client [label="withXxxClient\ncreate/configure", fillcolor="#EAF7EF", color="#58A978"]
  request [label="DSL request\ntyped model", fillcolor="#E9F7F6", color="#45A7A1"]
  service [label="AWS call\nnative suspend", fillcolor="#FFF7ED", color="#F97316"]
  close [label="Close client\nrelease pools", fillcolor="#FDECEF", color="#DC6B82"]
  scope -> client
  client -> request
