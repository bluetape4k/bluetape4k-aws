digraph aws_kotlin_flow_02 {
  graph [rankdir=TB, bgcolor="#ffffff", pad=0.35, nodesep=0.48, ranksep=0.70, splines=ortho]
  node [shape=box, style="rounded,filled", fontname="Architects Daughter", fontsize=12, margin="0.14,0.09", color="#94a3b8", fillcolor="#f8fafc"]
  edge [fontname="Comic Mono", fontsize=10, color="#64748b", penwidth=1.5, arrowsize=0.75]
  caller [label="Coroutine caller\nservice or repository", fillcolor="#E8F3FF", color="#5B8DEF"]
  client [label="withXClient / clientOf\nconfigure endpoint, region, credentials", fillcolor="#EAF7EF", color="#58A978"]
  request [label="Kotlin request DSL\ntyped suspend SDK model", fillcolor="#FFF3D9", color="#D6A441"]
  operation [label="Native suspend operation\nput, get, list, receive", fillcolor="#F4F7FA", color="#8CA0B3"]
  stream [label="Flow / paged results\nrecordFlow, list, receive", fillcolor="#E9F7F6", color="#45A7A1"]
  caller -> client
  client -> request
  request -> operation
  operation -> stream
}
