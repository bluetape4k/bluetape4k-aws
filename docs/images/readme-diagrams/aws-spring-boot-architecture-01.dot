digraph aws_spring_boot_architecture_01 {
  graph [rankdir=TB, bgcolor="#ffffff", pad=0.35, nodesep=0.48, ranksep=0.70, splines=ortho]
  node [shape=box, style="rounded,filled", fontname="Architects Daughter", fontsize=12, margin="0.14,0.09", color="#94a3b8", fillcolor="#f8fafc"]
  edge [fontname="Comic Mono", fontsize=10, color="#64748b", penwidth=1.5, arrowsize=0.75]
  app [label="Spring Boot application\ncontrollers and services", fillcolor="#E8F3FF", color="#5B8DEF"]
  props [label="AwsProperties\nregion, endpoint, credentials", fillcolor="#EAF7EF", color="#58A978"]
  auto [label="AwsAutoConfiguration\ncommon SDK client defaults", fillcolor="#F4F7FA", color="#8CA0B3"]
  s3 [label="S3AutoConfiguration\nS3Operations", fillcolor="#FFF3D9", color="#D6A441"]
  sqs [label="SqsAutoConfiguration\nSqsOperations, listeners", fillcolor="#FDECEF", color="#DC6B82"]
  ddb [label="DynamoDbAutoConfiguration\nrepository beans", fillcolor="#E9F7F6", color="#45A7A1"]
  kms [label="KmsAutoConfiguration\nKmsOperations", fillcolor="#F1ECFF", color="#8A72D6"]
  aws [label="AWS services\nLocalStack, Floci, RDS", fillcolor="#FFF0E3", color="#F47B36", shape=cylinder]
  app -> props
  props -> auto
  auto -> s3
  auto -> sqs
  auto -> ddb
  auto -> kms
  s3 -> aws
  sqs -> aws
  ddb -> aws
  kms -> aws
}
