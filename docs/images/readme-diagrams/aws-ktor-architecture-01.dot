digraph aws_ktor_architecture_01 {
  graph [rankdir=TB, bgcolor="#ffffff", pad=0.35, nodesep=0.48, ranksep=0.70, splines=ortho]
  node [shape=box, style="rounded,filled", fontname="Architects Daughter", fontsize=12, margin="0.14,0.09", color="#94a3b8", fillcolor="#f8fafc"]
  edge [fontname="Comic Mono", fontsize=10, color="#64748b", penwidth=1.5, arrowsize=0.75]
  app [label="Ktor application\nroutes, plugins, lifecycle", fillcolor="#E8F3FF", color="#5B8DEF"]
  core [label="AwsKtorCore\nshared defaults", fillcolor="#EAF7EF", color="#58A978"]
  defaults [label="AwsKtorDefaults\nregion, endpoint\ncredentials, clock", fillcolor="#FFF3D9", color="#D6A441"]
  s3 [label="S3KtorClient\nobject helpers", fillcolor="#FFF3D9", color="#D6A441"]
  sqs [label="SqsConsumer\npolling runtime", fillcolor="#FDECEF", color="#DC6B82"]
  ddb [label="DynamoDbKtorPlugin\nKotlin SDK client", fillcolor="#E9F7F6", color="#45A7A1"]
  aws [label="AWS / LocalStack\nS3, SQS, DynamoDB, RDS", fillcolor="#FFF0E3", color="#F47B36", shape=cylinder]
  app -> core
  core -> defaults
  defaults -> s3
  defaults -> sqs
  defaults -> ddb
  s3 -> aws
  sqs -> aws
  ddb -> aws
}
