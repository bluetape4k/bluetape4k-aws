digraph G {
  graph [rankdir=LR, bgcolor="#ffffff", pad=0.35, nodesep=0.55, ranksep=0.75, splines=ortho]
  node [shape=box, style="rounded,filled", fontname="Architects Daughter", fontsize=12, margin="0.14,0.09", color="#94a3b8", fillcolor="#f8fafc"]
  edge [fontname="Comic Mono", fontsize=10, penwidth=1.8, arrowsize=0.75, color="#3B82F6"]
  aws_java [label="aws-java\nJava SDK v2 wrappers\nsync / async / coroutine tiers", fillcolor="#E8F3FF", color="#5B8DEF"]
  aws_kotlin [label="aws-kotlin\nAWS Kotlin SDK helpers\nnative suspend + DSL builders", fillcolor="#EAF7EF", color="#58A978"]
  aws_spring_boot [label="aws-spring-boot\nSpring Boot 4 adapter\nauto-config / templates / listeners", fillcolor="#E9F7F6", color="#45A7A1"]
  aws_ktor [label="aws-ktor\nKtor 3 adapter\nSigV4 / S3 / SQS / DynamoDB plugins", fillcolor="#FFF3D9", color="#D6A441"]
  aws_exposed [label="aws-exposed\ndatabase foundation\nRDS IAM + AWS-backed config descriptors", fillcolor="#F1ECFF", color="#8A72D6"]
  bom [label="bom\nversion alignment\njava-platform constraints only", fillcolor="#FDECEF", color="#DC6B82"]
  ktor_examples [label="Ktor examples\nnot published\nDynamoDB / S3 / SQS / Exposed", fillcolor="#FFF7ED", color="#F97316"]
  spring_examples [label="Spring examples\nnot published\nDynamoDB / S3 / SQS / Exposed", fillcolor="#F8FAFC", color="#64748B"]
  aws_java -> aws_kotlin [style=invis]
  aws_kotlin -> aws_spring_boot [style=invis]
  aws_spring_boot -> aws_ktor [style=invis]
  aws_ktor -> aws_exposed [style=invis]
  aws_exposed -> bom [style=invis]
  bom -> ktor_examples [style=invis]
  ktor_examples -> spring_examples [style=invis]
}
