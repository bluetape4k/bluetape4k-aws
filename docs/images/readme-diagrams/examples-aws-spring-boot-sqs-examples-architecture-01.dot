digraph SpringSqsExamplesArchitecture {
  graph [rankdir=LR, bgcolor="#ffffff", pad=0.35, nodesep=0.45, ranksep=0.70, splines=ortho]
  node [shape=box, style="rounded,filled", fontname="Helvetica", fontsize=12, margin="0.14,0.09", color="#94a3b8", fillcolor="#f8fafc"]
  edge [fontname="Helvetica", fontsize=10, color="#64748b", penwidth=1.5, arrowsize=0.75]

  client [label="HTTP client or test", fillcolor="#e0f2fe", color="#38bdf8"]
  api [label="Spring WebFlux API\nqueue, message, fanout, DLQ routes", fillcolor="#dcfce7", color="#22c55e"]
  ops [label="SqsOperations and SnsOperations\ncoroutine templates", fillcolor="#fef3c7", color="#f59e0b"]
  listener [label="@SqsListener container\nreceives configured queue", fillcolor="#f3e8ff", color="#a855f7"]
  fanout [label="SNS to SQS fanout\nqueue policy and subscription", fillcolor="#fee2e2", color="#ef4444"]
  localstack [label="LocalStack SQS/SNS\nor AWS endpoints", shape=cylinder, fillcolor="#fff7ed", color="#f97316"]

  client -> api
  api -> ops
  ops -> localstack
  listener -> localstack [label="poll"]
  localstack -> listener [label="messages"]
  api -> fanout
  fanout -> localstack
}
