digraph aws_ktor_s3_advanced_architecture_01 {
  graph [rankdir=TB, bgcolor="#ffffff", pad=0.35, nodesep=0.48, ranksep=0.70, splines=ortho]
  node [shape=box, style="rounded,filled", fontname="Architects Daughter", fontsize=12, margin="0.14,0.09", color="#94a3b8", fillcolor="#f8fafc"]
  edge [fontname="Comic Mono", fontsize=10, color="#64748b", penwidth=1.5, arrowsize=0.75]
  app [label="Ktor application\nobject route handlers", fillcolor="#E8F3FF", color="#5B8DEF"]
  client [label="S3KtorClient\nadvanced helper", fillcolor="#FFF3D9", color="#D6A441"]
  detect [label="Content type detector\nmetadata inference", fillcolor="#E9F7F6", color="#45A7A1"]
  headers [label="Encryption headers\nserver-side options", fillcolor="#FDECEF", color="#DC6B82"]
  envelope [label="Envelope encryption\nclient-side data key", fillcolor="#F1ECFF", color="#8A72D6"]
  sigv4 [label="AwsSigV4Plugin\nsigned REST requests", fillcolor="#EAF7EF", color="#58A978"]
  s3 [label="AWS S3 / Floci / LocalStack\ncompatible endpoint", fillcolor="#FFF0E3", color="#F47B36", shape=cylinder]
  app -> client
  client -> detect
  client -> headers
  client -> envelope
  headers -> sigv4
  envelope -> sigv4
  sigv4 -> s3
}
