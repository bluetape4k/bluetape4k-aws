digraph G {
  graph [rankdir=LR, bgcolor="#ffffff", pad=0.35, nodesep=0.55, ranksep=0.75, splines=ortho]
  node [shape=box, style="rounded,filled", fontname="Architects Daughter", fontsize=12, margin="0.14,0.09", color="#94a3b8", fillcolor="#f8fafc"]
  edge [fontname="Comic Mono", fontsize=10, penwidth=1.8, arrowsize=0.75, color="#3B82F6"]
  metrics [label="MicrometerS3KtorClient\nwraps delegate\noperation timers", fillcolor="#E9F7F6", color="#45A7A1"]
  client [label="S3KtorClient\nobject API\npresigned URLs", fillcolor="#E8F3FF", color="#5B8DEF"]
  encryption [label="Client-side encryption\nAES-GCM envelope\nDataKeyProvider", fillcolor="#F1ECFF", color="#8A72D6"]
  meter [label="MeterRegistry\nlow-cardinality tags\ncaller supplied", fillcolor="#F8FAFC", color="#64748B"]
  sigv4 [label="S3 SigV4 policy\nunsigned payload\nS3 path rules", fillcolor="#EAF7EF", color="#58A978"]
  headers [label="SSE headers\nSSE-S3/SSE-KMS\nDSSE/SSE-C", fillcolor="#FFF3D9", color="#D6A441"]
  s3 [label="S3 endpoint\nAWS or emulator\nobject store", fillcolor="#FFF7ED", color="#F97316"]
  metrics -> client
  metrics -> meter
  encryption -> client
  client -> sigv4
  client -> headers
  sigv4 -> s3
  headers -> s3
}
