digraph G {
  graph [rankdir=TB, splines=ortho, nodesep=0.65, ranksep=0.85, bgcolor="transparent", label="Java SDK v2 architecture", labelloc=t];
  node [shape=box, style="rounded,filled", fontname="Arial", margin="0.12,0.08"];
  edge [penwidth=2.0, arrowsize=0.8, fontname="Arial"];
  app [label="Application code", fillcolor="#E8F3FF", color="#5B8DEF"];
  repo [label="Repository and templates", fillcolor="#E8F3FF", color="#5B8DEF"];
  auto [label="Spring/Ktor adapters", fillcolor="#E8F3FF", color="#5B8DEF"];
  models [label="Model builders", fillcolor="#FFF3D9", color="#D6A441"];
  extensions [label="Client extensions", fillcolor="#FFF3D9", color="#D6A441"];
  coroutines [label="Coroutine adapters", fillcolor="#EAF7EF", color="#58A978"];
  factories [label="Client factories", fillcolor="#F1ECFF", color="#8A72D6"];
  sdk [label="Java SDK v2 clients", fillcolor="#F4F7FA", color="#8CA0B3"];
  transfer [label="Transfer and waiters", fillcolor="#F4F7FA", color="#8CA0B3"];
  aws [label="AWS service APIs", fillcolor="#FFF0E3", color="#F47B36"];
  observability [label="Security and telemetry", fillcolor="#FFF0E3", color="#F47B36"];
  app -> models [color="#5B8DEF", xlabel="request shape"];
  repo -> extensions [color="#5B8DEF", xlabel="operations"];
  repo -> coroutines [color="#58A978", xlabel="suspend"];
  auto -> factories [color="#8A72D6", xlabel="client setup"];
  models -> sdk [color="#D6A441", xlabel="build"];
  extensions -> sdk [color="#D6A441", xlabel="invoke"];
  coroutines -> transfer [color="#58A978", xlabel="await"];
  factories -> transfer [color="#8A72D6", xlabel="compose"];
  sdk -> aws [color="#8CA0B3", xlabel="API calls"];
  transfer -> observability [color="#8CA0B3", xlabel="API calls"];
}
