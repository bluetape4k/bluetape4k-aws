digraph Bluetape4kAwsKotlinArchitecture {
  graph [rankdir=LR, bgcolor="#ffffff", pad=0.35, nodesep=0.45, ranksep=0.70, splines=ortho]
  node [shape=box, style="rounded,filled", fontname="Architects Daughter", fontsize=12, margin="0.14,0.09", color="#94a3b8", fillcolor="#f8fafc"]
  edge [fontname="Comic Mono", fontsize=10, color="#64748b", penwidth=1.5, arrowsize=0.75]

  app [label="Coroutine application", fillcolor="#e0f2fe", color="#38bdf8"]
  builders [label="DSL builders\nrequests, models, wait helpers", fillcolor="#dcfce7", color="#22c55e"]
  suspend [label="Native suspend calls\nwithXClient and service helpers", fillcolor="#fef3c7", color="#f59e0b"]
  http [label="HTTP engine support\nCRT or OkHttp where needed", fillcolor="#f3e8ff", color="#a855f7"]
  clients [label="AWS SDK for Kotlin clients\nDynamoDB, S3, SQS, SNS,\nKMS, CloudWatch, Kinesis, STS", fillcolor="#f8fafc", color="#94a3b8"]
  aws [label="AWS services\nor local emulator", shape=cylinder, fillcolor="#fff7ed", color="#f97316"]

  app -> builders
  app -> suspend
  suspend -> clients
  builders -> clients
  http -> clients
  clients -> aws
}
