digraph G {
  graph [rankdir=TB, splines=ortho, nodesep=0.65, ranksep=0.85, bgcolor="transparent", label="Kotlin SDK architecture", labelloc=t];
  node [shape=box, style="rounded,filled", fontname="Arial", margin="0.12,0.08"];
  edge [penwidth=2.0, arrowsize=0.8, fontname="Arial"];
  coroutine_app [label="Coroutine application", fillcolor="#E8F3FF", color="#5B8DEF"];
  ktor_runtime [label="Ktor runtime", fillcolor="#E8F3FF", color="#5B8DEF"];
  examples [label="Examples", fillcolor="#F1ECFF", color="#8A72D6"];
  dsl [label="Suspend request DSL", fillcolor="#FFF3D9", color="#D6A441"];
  clients [label="Client helpers", fillcolor="#EAF7EF", color="#58A978"];
  flows [label="Flow adapters", fillcolor="#EAF7EF", color="#58A978"];
  engines [label="HTTP engines", fillcolor="#F1ECFF", color="#8A72D6"];
  smithy [label="AWS SDK for Kotlin", fillcolor="#F4F7FA", color="#8CA0B3"];
  java_bridge [label="Java SDK bridge", fillcolor="#F4F7FA", color="#8CA0B3"];
  services [label="Data services", fillcolor="#FFF0E3", color="#F47B36"];
  ops [label="Ops services", fillcolor="#FFF0E3", color="#F47B36"];
  coroutine_app -> dsl [color="#5B8DEF", xlabel="build"];
  coroutine_app -> clients [color="#58A978", xlabel="call"];
  ktor_runtime -> clients [color="#5B8DEF", xlabel="plugin"];
  ktor_runtime -> engines [color="#8A72D6", xlabel="transport"];
  examples -> flows [color="#8A72D6", xlabel="exercise"];
  dsl -> smithy [color="#D6A441", xlabel="requests"];
  clients -> smithy [color="#58A978", xlabel="suspend"];
  flows -> java_bridge [color="#58A978", xlabel="stream"];
  engines -> java_bridge [color="#8A72D6", xlabel="sign"];
  smithy -> services [color="#8CA0B3", xlabel="service calls"];
  java_bridge -> ops [color="#8CA0B3", xlabel="support calls"];
}
