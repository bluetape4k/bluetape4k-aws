digraph G {
  graph [rankdir=TB, splines=ortho, nodesep=0.65, ranksep=0.85, bgcolor="transparent", label="Runtime architecture", labelloc=t];
  node [shape=box, style="rounded,filled", fontname="Arial", margin="0.12,0.08"];
  edge [penwidth=2.0, arrowsize=0.8, fontname="Arial"];
  spring [label="Spring Boot apps", fillcolor="#E8F3FF", color="#5B8DEF"];
  ktor [label="Ktor services", fillcolor="#E8F3FF", color="#5B8DEF"];
  kotlin_app [label="Kotlin services", fillcolor="#E8F3FF", color="#5B8DEF"];
  examples [label="Examples", fillcolor="#F1ECFF", color="#8A72D6"];
  spring_mod [label="aws-spring-boot", fillcolor="#FFF3D9", color="#D6A441"];
  ktor_mod [label="aws-ktor", fillcolor="#FFF3D9", color="#D6A441"];
  java_mod [label="aws-java", fillcolor="#EAF7EF", color="#58A978"];
  kotlin_mod [label="aws-kotlin", fillcolor="#EAF7EF", color="#58A978"];
  sdk_java [label="AWS SDK for Java v2", fillcolor="#F4F7FA", color="#8CA0B3"];
  sdk_kotlin [label="AWS SDK for Kotlin", fillcolor="#F4F7FA", color="#8CA0B3"];
  exposed [label="Exposed + JDBC", fillcolor="#F4F7FA", color="#8CA0B3"];
  services [label="AWS services", fillcolor="#FFF0E3", color="#F47B36"];
  config [label="Config and emulators", fillcolor="#FFF0E3", color="#F47B36"];
  spring -> spring_mod [color="#5B8DEF", xlabel="auto-config"];
  ktor -> ktor_mod [color="#5B8DEF", xlabel="plugins"];
  kotlin_app -> java_mod [color="#58A978", xlabel="helpers"];
  examples -> kotlin_mod [color="#8A72D6", xlabel="exercise"];
  spring_mod -> sdk_java [color="#D6A441", xlabel="Java SDK"];
  ktor_mod -> sdk_kotlin [color="#D6A441", xlabel="Kotlin SDK"];
  java_mod -> sdk_java [color="#58A978", xlabel="wrap"];
  kotlin_mod -> sdk_kotlin [color="#58A978", xlabel="wrap"];
  spring_mod -> exposed [color="#8A72D6", xlabel="JDBC config"];
  sdk_java -> services [color="#8CA0B3", xlabel="service calls"];
  sdk_kotlin -> services [color="#8CA0B3", xlabel="suspend calls"];
  exposed -> config [color="#8A72D6", xlabel="credentials"];
  examples -> config [color="#8A72D6", xlabel="local verify", style=dashed];
}
