digraph Bluetape4kAwsKmsFlow {
  graph [rankdir=TB, bgcolor="#ffffff", pad=0.35, nodesep=0.45, ranksep=0.70, splines=ortho]
  node [shape=box, style="rounded,filled", fontname="Architects Daughter", fontsize=12, margin="0.14,0.09", color="#94a3b8", fillcolor="#f8fafc"]
  edge [fontname="Comic Mono", fontsize=10, color="#64748b", penwidth=1.5, arrowsize=0.75]

  request [label="Application calls KmsOperations\nwith plaintext or ciphertext", fillcolor="#e0f2fe", color="#38bdf8"]
  defaults [label="Apply configured key id\nand encryption context", fillcolor="#dcfce7", color="#22c55e"]
  cache [label="Use DataKeyCache only for\nenvelope-encryption data keys", fillcolor="#f1f5f9", color="#64748b"]
  encrypt [label="Encrypt path\nKMS Encrypt or GenerateDataKey", fillcolor="#fef3c7", color="#f59e0b"]
  decrypt [label="Decrypt path\nKMS Decrypt with same context", fillcolor="#fee2e2", color="#ef4444"]
  response [label="Return ciphertext, plaintext,\nor encrypted data key metadata", fillcolor="#f3e8ff", color="#a855f7"]
  kms [label="AWS KMS\nsmall secrets and key management", shape=cylinder, fillcolor="#fff7ed", color="#f97316"]

  request -> defaults -> cache
  cache -> encrypt
  cache -> decrypt
  encrypt -> kms
  decrypt -> kms
  kms -> response
}
