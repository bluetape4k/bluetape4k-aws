digraph Bluetape4kAwsKmsComponents {
  graph [rankdir=LR, bgcolor="#ffffff", pad=0.35, nodesep=0.45, ranksep=0.70, splines=ortho]
  node [shape=box, style="rounded,filled", fontname="Architects Daughter", fontsize=12, margin="0.14,0.09", color="#94a3b8", fillcolor="#f8fafc"]
  edge [fontname="Comic Mono", fontsize=10, color="#64748b", penwidth=1.5, arrowsize=0.75]

  service [label="Application service", fillcolor="#e0f2fe", color="#38bdf8"]
  text [label="TextEncryptor\noptional adapter", fillcolor="#f3e8ff", color="#a855f7"]
  auto [label="KmsAutoConfiguration\nproperties, client, cache", fillcolor="#fef3c7", color="#f59e0b"]
  ops [label="KmsOperations\ncoroutine API", fillcolor="#dcfce7", color="#22c55e"]
  encryptor [label="KmsCoroutinesEncryptor\nEncrypt, Decrypt, data keys", fillcolor="#fee2e2", color="#ef4444"]
  cache [label="DataKeyCache\nshort-lived plaintext keys", fillcolor="#f1f5f9", color="#64748b"]
  client [label="KmsAsyncClient\nAWS SDK v2", fillcolor="#f8fafc", color="#94a3b8"]
  kms [label="AWS KMS\nor LocalStack", shape=cylinder, fillcolor="#fff7ed", color="#f97316"]

  service -> ops
  service -> text
  auto -> ops
  auto -> cache
  ops -> encryptor
  text -> ops
  encryptor -> cache
  encryptor -> client
  client -> kms
}
